# Copy to .env for local development. Production values are set in the
# Render dashboard (see ../../render.yaml and ../../README.md).

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://xrspectre:xrspectre@localhost:5433/xrspectre?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────
# At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-to-a-long-random-string"

# ── The single administrator account (created/updated by `npm run seed`) ─
ADMIN_EMAIL="admin@xrspectre.com"
# At least 12 characters. Leave empty to have a random one generated and
# printed once by the seed script.
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# ── Code execution ──────────────────────────────────────────────────────
#   judge0 – Judge0 CE (self-hosted or RapidAPI). Recommended for Render.
#   piston – a Piston instance
#   docker – throw-away containers from ./sandbox-runner (needs a Docker
#            daemon, so only for VM / self-hosted deployments)
#   stub   – runs nothing and marks every test case as passed. UI
#            development only; refused when NODE_ENV=production unless
#            ALLOW_STUB_EXECUTION=true.
EXECUTION_PROVIDER="stub"

JUDGE0_URL="http://localhost:2358"
# Self-hosted Judge0 with AUTHN_TOKEN enabled:
JUDGE0_AUTH_TOKEN=""
# RapidAPI-hosted Judge0 CE (JUDGE0_URL=https://judge0-ce.p.rapidapi.com):
JUDGE0_RAPIDAPI_KEY=""
JUDGE0_RAPIDAPI_HOST=""

PISTON_URL="http://localhost:2000"
# Sent as the Authorization header, if your Piston instance needs one.
PISTON_API_KEY=""

# Build with: docker build -t xrspectre-sandbox ./sandbox-runner
DOCKER_SANDBOX_IMAGE="xrspectre-sandbox"

# ── HTTP ────────────────────────────────────────────────────────────────
PORT=4000
# Only needed when the frontend is served from a different origin (e.g.
# the Vite dev server). Comma-separated.
CLIENT_ORIGIN="http://localhost:5173"
# Number of reverse proxies in front of the app (Render: 1).
TRUST_PROXY=1
# Lock an attempt to the IP address it was started from (anti-cheat).
# Set to false if students' networks change IP mid-test.
ENFORCE_ATTEMPT_IP_LOCK=true

# ── Subjective-answer grading ───────────────────────────────────────────
# 'stub' awards full marks to every non-empty answer.
# 'openai-compatible' works with OpenAI, Groq, OpenRouter, Ollama, …
AI_EVALUATION_PROVIDER="stub"
AI_API_KEY=""
AI_ENDPOINT="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"
